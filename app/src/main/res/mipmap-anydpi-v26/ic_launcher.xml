<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 29, so an adaptive icon alone covers every device that can run CLUTCH. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Themed-icon layer: must use the 108dp foreground, not the 24dp status-bar icon,
         or Android 13+ scales the wrong safe zone and the bolt comes out tiny. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
