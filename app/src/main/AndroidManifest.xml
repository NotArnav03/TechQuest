<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Screen capture + the audio tap that scores highlights -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Required on API 34 because the recorder also opens the mic for the clip soundtrack -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used once per session, after capture stops, to rank and title the clips.
         Capture and detection never touch the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No WRITE_EXTERNAL_STORAGE: it only applies up to API 28 and minSdk here is 29.
         Clips live in the app's own external files dir, which needs no permission. -->

    <application
        android:allowBackup="false"
        android:label="CLUTCH"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Clutch"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Clutch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType is mandatory on API 34 for MediaProjection services.
             |microphone is required too, since MediaRecorder opens MIC for clip audio. -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Lets the share sheet hand exported clips to other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
